# ============================================================
# EcoPower ID — Contoh konfigurasi lingkungan
# Salin ke `.env` lalu isi nilai yang sesuai.
# JANGAN commit file .env ke git (berisi kata sandi).
# ============================================================

# ----- Database (diisi otomatis oleh docker-compose bila pakai compose) -----
# Untuk pengembangan lokal tanpa Docker:
# DATABASE_URL="postgresql://ecopower:ecopower@localhost:5432/ecopower?schema=public"
DATABASE_URL="postgresql://ecopower:ecopower@db:5432/ecopower?schema=public"

# ----- Kredensial admin -----
# Kata sandi panel admin (WAJIB diganti!)
ADMIN_PASSWORD="ganti-ini-dengan-kata-sandi-kuat"
# Secret sesi minimal 32 karakter (WAJIB diganti!)
SESSION_SECRET="ganti-ini-dengan-string-acak-panjang-minimal-32-karakter"

# ----- AI saran harga pasar (opsional) -----
# Endpoint OpenAI-compatible. Kosongkan AI_API_KEY untuk menonaktifkan fitur.
#
# Contoh 1 — OpenAI:
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o-mini"
#
# Contoh 2 — Ollama lokal (server yang sama):
# AI_BASE_URL="http://host.docker.internal:11434/v1"
# AI_API_KEY="ollama"
# AI_MODEL="llama3.1"
#
# Contoh 3 — Ollama di host lain:
# AI_BASE_URL="http://192.168.1.10:11434/v1"
# AI_API_KEY="ollama"
# AI_MODEL="qwen2.5"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# ----- Informasi bisnis (opsional — default di src/lib/site-config.ts) -----
SITE_PHONE="+62 812-3456-7890"
SITE_WHATSAPP="6281234567890"
SITE_EMAIL="halo@ecopower.id"
SITE_ADDRESS_ID="Jl. Contoh No. 1, Indonesia"
SITE_ADDRESS_EN="Jl. Contoh No. 1, Indonesia"

# ----- Kebijakan RAB (opsional) -----
RAB_MARGIN_PCT=15        # margin bengkel (%)
RAB_PPN_PCT=11           # PPN (%)
RAB_INCLUDE_PPN=true     # sertakan PPN di total

# ----- AI Photorealistic Render (opsional) -----
# Daftar gratis di https://replicate.com, dapatkan API token.
# Tanpa token ini, fitur AI Render tidak akan aktif.
REPLICATE_API_TOKEN=""

# ----- Asumsi kalkulasi PLTS (opsional) -----
PLTS_SUN_HOURS=4.5       # jam puncak matahari rata-rata (Indonesia)
PLTS_JASA_PER_WP=2000    # tarif jasa instalasi per Wp (fallback bila komponen JASA tidak ada)
